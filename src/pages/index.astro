---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// The contact form POSTs to one self-hosted relay (m4, public over Tailscale
// Funnel). No email address is ever in the page. The origin is allow-listed in
// Base.astro's CSP connect-src.
const RELAY = 'https://m4.tail7d04cf.ts.net:10000/lead';
---

<Base title="lirova · Engineering Portfolio">
  <section class="hero wrap">
    <p class="eyebrow">Front end · Full stack · Self-hosted</p>
    <h1>Web apps I build,<br />and use every day.</h1>
    <p class="lede">
      I build browser front ends and the servers behind them, to fix problems I
      actually have. Each project below says what the problem was, what I built,
      and the result I can show, and whether I still use it.
    </p>
    <div class="links">
      <a href="/#work" class="btn btn-primary">See the work &rarr;</a>
      <a href="/#demo" class="btn btn-ghost">Watch the demos</a>
    </div>
  </section>

  <section class="metrics">
    <div class="wrap">
      <div class="metric"><div class="num">21,858</div><div class="lbl">AI requests through my home fleet endpoint since Aug 4, 2026</div></div>
      <div class="metric"><div class="num">1,318</div><div class="lbl">spoken clips from my voice page in one week</div></div>
      <div class="metric"><div class="num">1,400+</div><div class="lbl">commits to the production web app I lead at work</div></div>
      <div class="metric"><div class="num">980+</div><div class="lbl">commits to my no-framework browser game since July</div></div>
    </div>
  </section>

  <section id="demo" class="section wrap">
    <div class="section-head">
      <p class="section-title">Demos</p>
      <h2>Real screens, recorded in June 2026.</h2>
      <p>Each clip is under 35 seconds and uses sample data.</p>
    </div>

    <div class="demo-block">
      <h3>workbank: one task board for everything waiting on me <span class="status status-before">Used before</span></h3>
      <p>
        Requests reached me in four places and some got lost. workbank pulls
        email, calendar, GitHub and Slack into one board, and an AI model writes
        the real ask for each message. Since June 6, 2026 it has pulled out 1,207
        asks, and I closed 328 of them through the board by August 7.
      </p>
      <div class="media-frame">
        <div class="bar"><i></i><i></i><i></i><span>workbank &mdash; sample data</span></div>
        <video controls preload="metadata" poster="/workbank-demo-v2-poster.jpg">
          <source src="/workbank-demo-v2.mp4" type="video/mp4" />
          <a href="/workbank-demo-v2.mp4">download the clip</a>.
        </video>
      </div>
    </div>

    <div class="demo-block">
      <h3>Voice console: my AI sessions, read aloud <span class="status status-daily">Used daily</span></h3>
      <p>
        I run several AI coding sessions at once and couldn&apos;t keep up with
        reading them. This phone page reads each reply out loud and takes my
        answer by voice. In the week of September 21, 2026 I used it every day:
        1,318 spoken clips. The clip shows the first version; I use its successor.
      </p>
      <div class="media-frame">
        <div class="bar"><i></i><i></i><i></i><span>voice console &mdash; first version</span></div>
        <video controls preload="metadata" poster="/voicebot-demo-v1-poster.jpg">
          <source src="/voicebot-demo-v1.mp4" type="video/mp4" />
          <a href="/voicebot-demo-v1.mp4">download the clip</a>.
        </video>
      </div>
    </div>

    <div class="demo-block">
      <h3>daki: GitHub issues in, reviewed pull requests out <span class="status status-shelved">Shelved</span></h3>
      <p>
        Small bug fixes waited on me. daki took a labeled GitHub issue, wrote the
        fix, opened a pull request, reviewed it and merged it. Result: 6
        agent-written pull requests merged between June 7 and June 28, 2026.
        It&apos;s shelved now, because a general coding agent does this job
        better for me. The clip is a real, unedited run.
      </p>
      <div class="media-frame">
        <div class="bar"><i></i><i></i><i></i><span>daki &mdash; real run, June 2026</span></div>
        <video controls preload="metadata" poster="/daki-demo-v3-poster.jpg">
          <source src="/daki-demo-v3.mp4" type="video/mp4" />
          <a href="/daki-demo-v3.mp4">download the clip</a>.
        </video>
      </div>
    </div>
  </section>

  <section id="work" class="section wrap">
    <div class="section-head">
      <p class="section-title">Work</p>
      <h2>Problem, what I built, and the result.</h2>
    </div>
    <div class="grid">
      {projects.map((p) => (
        <ProjectCard
          slug={p.id}
          title={p.data.title}
          summary={p.data.summary}
          domain={p.data.domain}
          stack={p.data.stack}
          status={p.data.status}
        />
      ))}
    </div>
  </section>

  <section id="contact" class="section wrap" style="text-align:center;">
    <p class="section-title" style="margin-bottom:.7rem;">Contact</p>
    <h2 style="font-size:clamp(1.8rem,3.6vw,2.5rem);margin:0 0 1.1rem;">Want to talk about a role or a project?</h2>
    <p style="max-width:54ch;margin:0 auto 1.8rem;color:var(--text-dim);">
      Send a note and I&apos;ll reply by email.
    </p>
    <form id="contact-form" class="contact-form" data-relay={RELAY}>
      <!-- honeypot: humans never see/fill this; bots do, and get dropped -->
      <input type="checkbox" name="botcheck" class="cf-hp" tabindex="-1" autocomplete="off" />
      <div class="cf-row">
        <label class="cf-field"><span>Name</span>
          <input type="text" name="name" required autocomplete="name" /></label>
        <label class="cf-field"><span>Company <em>(optional)</em></span>
          <input type="text" name="company" autocomplete="organization" /></label>
      </div>
      <label class="cf-field"><span>Your email <em>(so I can reply)</em></span>
        <input type="email" name="email" required autocomplete="email" /></label>
      <label class="cf-field"><span>Message</span>
        <textarea name="message" rows="4" required
          placeholder="The role or project, and how to reach you."></textarea></label>
      <button type="submit" class="btn btn-primary cf-send">Send &rarr;</button>
      <p class="cf-trust">Goes straight to me. No account, no newsletter.</p>
      <p id="cf-status" class="cf-status" role="status" aria-live="polite"></p>
    </form>
    <p style="margin:1.2rem 0 0;font-size:.85rem;opacity:.55;">
      Or on GitHub:
      <a href="https://github.com/lirova" target="_blank" rel="noopener" style="color:inherit;">github.com/lirova</a>
    </p>
  </section>

  <script>
    // Contact form: POST to the self-hosted relay. Success ONLY on a real 200 with
    // success:true, so it never shows a false "sent"; a failure says so honestly.
    // No email address in the DOM.
    (() => {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const statusEl = document.getElementById('cf-status');
      const btn = form?.querySelector('.cf-send') as HTMLButtonElement | null;
      if (!form || !statusEl || !btn) return;

      async function send(url: string, payload: object, ms: number): Promise<boolean> {
        if (!url) return false;
        const ctl = new AbortController();
        const t = setTimeout(() => ctl.abort(), ms);
        try {
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal: ctl.signal,
          });
          if (!res.ok) return false;
          const data = await res.json().catch(() => ({}));
          return data.success === true;
        } catch {
          return false; // timeout / network / CORS
        } finally {
          clearTimeout(t);
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const original = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        statusEl.textContent = '';
        statusEl.className = 'cf-status';

        const fd = new FormData(form);
        const payload = {
          name: fd.get('name'), email: fd.get('email'),
          company: fd.get('company'), message: fd.get('message'),
          botcheck: fd.get('botcheck') ? '1' : '',
        };
        const ok = await send(form.dataset.relay || '', payload, 8000);

        if (ok) {
          form.reset();
          statusEl.textContent = "Sent. I'll reply by email. Thanks.";
          statusEl.classList.add('ok');
          btn.textContent = 'Sent ✓';
          return; // leave as confirmation; never a false success
        }
        statusEl.textContent = "Couldn't send that just now. Please try again in a moment.";
        statusEl.classList.add('err');
        btn.disabled = false;
        btn.textContent = original;
      });
    })();
  </script>

</Base>
